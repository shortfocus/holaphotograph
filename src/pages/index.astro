---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- 강의 홍보 팝업 (메인 진입 시 1회) -->
  <div
    id="class-promo-popup"
    class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/60 p-3 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="class-promo-title"
  >
    <div
      class="relative mt-8 flex max-h-[85vh] w-full max-w-sm flex-col overflow-hidden rounded-xl bg-[#0F172A] shadow-2xl ring-1 ring-white/10 sm:mt-12"
    >
      <!-- 헤더 -->
      <div
        class="relative flex shrink-0 items-center justify-center border-b border-slate-700/50 bg-[#0F172A] p-4"
      >
        <h2
          id="class-promo-title"
          class="text-lg font-bold text-white sm:text-xl"
        >
          올라포토 강의 안내
        </h2>
        <button
          type="button"
          id="class-promo-close"
          class="absolute right-4 top-1/2 -translate-y-1/2 cursor-pointer rounded p-1.5 text-slate-400 hover:bg-white/10 hover:text-white"
          aria-label="팝업 닫기"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path></svg
          >
        </button>
      </div>
      <!-- 슬라이드 영역: 모바일에서 이미지 잘림 방지(트랙/슬라이드 너비 명시, min-w-0) -->
      <div
        id="class-promo-slider"
        class="relative flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden"
      >
        <button
          type="button"
          id="class-promo-prev"
          class="absolute left-1 top-1/2 z-10 -translate-y-1/2 rounded-full border border-slate-600/40 bg-slate-800/90 p-2 text-white shadow backdrop-blur-sm transition hover:bg-slate-700"
          aria-label="이전"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        </button>
        <button
          type="button"
          id="class-promo-next"
          class="absolute right-1 top-1/2 z-10 -translate-y-1/2 rounded-full border border-slate-600/40 bg-slate-800/90 p-2 text-white shadow backdrop-blur-sm transition hover:bg-slate-700"
          aria-label="다음"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </button>
        <div class="relative min-h-0 min-w-0 flex-1 overflow-hidden">
          <div
            class="class-promo-track flex h-full transition-transform duration-300 ease-out"
            style="width: 200%; transform: translateX(0);"
          >
            <div
              class="class-promo-slide flex min-h-0 w-1/2 shrink-0 flex-col px-2 py-4"
            >
              <div
                class="flex min-h-0 min-w-0 flex-1 items-center justify-center overflow-hidden"
              >
                <a
                  href="/notice?id=5"
                  class="class-promo-image-link flex min-w-0 max-w-full cursor-pointer"
                  aria-label="국중박 출사 공지 상세로 이동"
                >
                  <img
                    src="/images/class-museum.png"
                    alt="국중박 출사 · 2026.04.18(토) 오후 1시~3시 · 국립중앙박물관 · 2만원"
                    class="max-h-[60vh] w-full max-w-full rounded-lg object-contain object-center"
                  />
                </a>
              </div>
            </div>
            <div
              class="class-promo-slide flex min-h-0 w-1/2 shrink-0 flex-col px-2 py-4"
            >
              <div
                class="flex min-h-0 min-w-0 flex-1 items-center justify-center overflow-hidden"
              >
                <a
                  href="/notice?id=5"
                  class="class-promo-image-link flex min-w-0 max-w-full cursor-pointer"
                  aria-label="X-E5 오프라인 클래스 공지 상세로 이동"
                >
                  <img
                    src="/images/class-xe5.png"
                    alt="X-E5 class · 2026.04.18(토) 오전 10시~12시 · 즐카 · 2만원"
                    class="max-h-[60vh] w-full max-w-full rounded-lg object-contain object-center"
                  />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- 푸터 -->
      <div
        class="flex shrink-0 flex-col gap-2 border-t border-slate-700/50 p-4 sm:flex-row sm:items-center sm:justify-between"
      >
        <label
          class="flex cursor-pointer items-center gap-1.5 text-xs text-slate-400"
        >
          <input
            type="checkbox"
            id="class-promo-dont-show"
            class="rounded border-slate-600 bg-slate-800 text-[#E11D48] focus:ring-[#E11D48]"
          />
          오늘 하루 안 보기
        </label>
        <button
          type="button"
          id="class-promo-close-btn"
          class="cursor-pointer rounded-lg bg-[#E11D48] px-4 py-2 text-xs font-semibold text-white hover:bg-[#be123c]"
        >
          닫기
        </button>
      </div>
    </div>
  </div>

  <!-- 모집 정보 팝업 (gr_14~gr_15) -->
  <div
    id="gr-promo-popup"
    class="fixed inset-0 z-[59] hidden items-center justify-center bg-black/60 p-3 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="gr-promo-title"
  >
    <div
      class="relative mt-8 flex max-h-[85vh] w-full max-w-sm flex-col overflow-hidden rounded-xl bg-[#0F172A] shadow-2xl ring-1 ring-white/10 sm:mt-12"
    >
      <div
        class="relative flex shrink-0 items-center justify-center border-b border-slate-700/50 bg-[#0F172A] p-4"
      >
        <h2 id="gr-promo-title" class="text-lg font-bold text-white sm:text-xl">
          모집 정보
        </h2>
        <button
          type="button"
          id="gr-promo-close"
          class="absolute right-4 top-1/2 -translate-y-1/2 cursor-pointer rounded p-1.5 text-slate-400 hover:bg-white/10 hover:text-white"
          aria-label="팝업 닫기"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path></svg
          >
        </button>
      </div>
      <div
        id="gr-promo-slider"
        class="relative flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden"
      >
        <button
          type="button"
          id="gr-promo-prev"
          class="absolute left-1 top-1/2 z-10 -translate-y-1/2 rounded-full border border-slate-600/40 bg-slate-800/90 p-2 text-white shadow backdrop-blur-sm transition hover:bg-slate-700"
          aria-label="이전"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        </button>
        <button
          type="button"
          id="gr-promo-next"
          class="absolute right-1 top-1/2 z-10 -translate-y-1/2 rounded-full border border-slate-600/40 bg-slate-800/90 p-2 text-white shadow backdrop-blur-sm transition hover:bg-slate-700"
          aria-label="다음"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </button>
        <div class="relative min-h-0 min-w-0 flex-1 overflow-hidden">
          <div
            class="gr-promo-track flex h-full transition-transform duration-300 ease-out"
            style="width: 200%; transform: translateX(0);"
          >
            <div
              class="gr-promo-slide flex min-h-0 w-1/2 shrink-0 flex-col px-2 py-4"
            >
              <div
                class="flex min-h-0 min-w-0 flex-1 items-center justify-center overflow-hidden"
              >
                <a
                  href="/notice?id=10"
                  class="gr-promo-image-link flex min-w-0 max-w-full cursor-pointer"
                  aria-label="리코 GR4 노출의 3요소 강의 공지 상세로 이동"
                >
                  <img
                    src="/images/gr_14.png"
                    alt="리코 GR4 노출의 3요소 강의 · 2026.07.11(토) 오후 2시~4시 · 즐거운 카메라 · 2만원"
                    class="max-h-[60vh] w-full max-w-full rounded-lg object-contain object-center"
                  />
                </a>
              </div>
            </div>
            <div
              class="gr-promo-slide flex min-h-0 w-1/2 shrink-0 flex-col px-2 py-4"
            >
              <div
                class="flex min-h-0 min-w-0 flex-1 items-center justify-center overflow-hidden"
              >
                <a
                  href="/notice?id=10"
                  class="gr-promo-image-link flex min-w-0 max-w-full cursor-pointer"
                  aria-label="리코 GR4 카메라 매뉴얼 강의 공지 상세로 이동"
                >
                  <img
                    src="/images/gr_15.png"
                    alt="리코 GR4 카메라 매뉴얼 강의 · 2026.07.11(토) 오전 11시~오후 1시 · 즐거운 카메라 · 2만원"
                    class="max-h-[60vh] w-full max-w-full rounded-lg object-contain object-center"
                  />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="flex shrink-0 flex-col gap-2 border-t border-slate-700/50 p-4 sm:flex-row sm:items-center sm:justify-between"
      >
        <label
          class="flex cursor-pointer items-center gap-1.5 text-xs text-slate-400"
        >
          <input
            type="checkbox"
            id="gr-promo-dont-show"
            class="rounded border-slate-600 bg-slate-800 text-[#E11D48] focus:ring-[#E11D48]"
          />
          오늘 하루 안 보기
        </label>
        <button
          type="button"
          id="gr-promo-close-btn"
          class="cursor-pointer rounded-lg bg-[#E11D48] px-4 py-2 text-xs font-semibold text-white hover:bg-[#be123c]"
        >
          닫기
        </button>
      </div>
    </div>
  </div>

  <!-- 2. 히어로 섹션 (리코 단일 슬라이드) -->
  <section
    class="hero-section relative left-0 right-0 w-full min-w-full overflow-hidden bg-[#0F172A] pt-[4rem]"
  >
    <div id="hero-bg-slides" class="absolute inset-0" aria-hidden="true">
      <div
        class="hero-bg-slide is-active"
        style="background-image: url('/images/hero-bg/01-camera.jpg');"
      >
      </div>
      <div
        class="hero-bg-slide"
        style="background-image: url('/images/hero-bg/02-camera.jpg');"
      >
      </div>
      <div
        class="hero-bg-slide"
        style="background-image: url('/images/hero-bg/03-camera.jpg');"
      >
      </div>
    </div>
    <div
      class="absolute inset-0 bg-[#0F172A]/80"
      aria-hidden="true"
    >
    </div>
    <div
      class="hero-glow absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(225,29,72,0.1),transparent)] pointer-events-none"
      aria-hidden="true"
    >
    </div>
    <div
      class="hero-noise absolute inset-0 pointer-events-none"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 flex h-full flex-col overflow-hidden">
      <div
        class="hero-slide flex h-full min-h-0 shrink-0 items-center justify-center overflow-y-auto overflow-x-hidden py-2 sm:py-4 lg:py-6"
      >
        <div
          class="relative mx-auto flex w-full min-w-0 max-w-7xl flex-col items-center justify-center gap-8 px-4 py-24 sm:px-6 lg:flex-row lg:gap-16 lg:px-8"
        >
          <div class="flex-1 text-center lg:text-left">
            <span
              class="hero-animate inline-block rounded-full border border-[#E11D48]/40 bg-[#E11D48]/10 px-4 py-1.5 text-xs font-medium uppercase tracking-wider text-red-300"
              style="animation-delay: 0ms; opacity: 0"
              >Ricoh Specialist</span
            >
            <h1
              class="hero-animate mt-6 max-w-3xl text-2xl font-bold leading-snug tracking-tight text-white sm:text-3xl md:text-4xl lg:text-5xl"
              style="animation-delay: 100ms; opacity: 0"
            >
              찰나의 시선이 기록이 되는 순간,<br />
              <span class="text-[#F43F5E]">리코</span> 유저를 위한 실전 가이드
            </h1>
            <p
              class="hero-animate mx-auto mt-4 max-w-xl text-base leading-relaxed text-slate-300 sm:text-lg lg:mx-0 lg:text-xl"
              style="animation-delay: 200ms; opacity: 0"
            >
              리코 고유의 색감 표현부터 실전 스냅 스킬, 깊이 있는 장비 분석까지
            </p>
            <div
              class="hero-animate mt-8 flex items-center justify-center gap-6 lg:justify-start"
              style="animation-delay: 300ms; opacity: 0"
            >
              <a
                href="https://youtube.com/channel/UCsD5VP6TvRMt-sq0q25HlIA"
                target="_blank"
                rel="noopener noreferrer"
                class="hero-channel-icon group"
                aria-label="유튜브"
              >
                <img src="/icons/youtube.svg" alt="" aria-hidden="true" />
              </a>
              <a
                href="https://blog.naver.com/holaphotograph"
                target="_blank"
                rel="noopener noreferrer"
                class="hero-channel-icon"
                aria-label="네이버 블로그"
              >
                <img
                  src="/icons/naver-blog-hover.svg"
                  alt=""
                  aria-hidden="true"
                />
              </a>
              <a
                href="https://www.instagram.com/snap.hola"
                target="_blank"
                rel="noopener noreferrer"
                class="hero-channel-icon group"
                aria-label="인스타그램"
              >
                <img src="/icons/instagram.svg" alt="" aria-hidden="true" />
              </a>
              <a
                href="mailto:holaphotographer@gmail.com"
                class="hero-channel-icon group"
                aria-label="문의하기"
              >
                <img src="/icons/contact.svg" alt="" aria-hidden="true" />
              </a>
            </div>
          </div>
          <div
            class="hero-animate flex-1 min-w-0"
            style="animation-delay: 150ms; opacity: 0"
          >
            <div
              class="overflow-hidden rounded-2xl shadow-2xl shadow-black/30 ring-1 ring-white/10"
            >
              <iframe
                src="https://www.youtube.com/embed/7BYd6RJp3RY?rel=0&autoplay=1&mute=1"
                title="올라포토 리코 강의 영상"
                class="aspect-video w-full min-h-[200px] sm:min-h-[280px]"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2-1. 수강생 후기 마퀴 (히어로 직후) -->
  <section
    id="reviews-marquee"
    class="reviews-marquee-section border-t border-slate-200/60 bg-[#F8FAFC] py-10 sm:py-12"
    aria-label="고객 후기"
  >
    <div class="mx-auto mb-6 flex max-w-6xl items-end justify-between gap-4 px-4 sm:px-6">
      <div>
        <p class="text-sm font-medium text-[#6B7280]">강의 · 스냅 촬영 후기</p>
        <h2 class="mt-1 text-xl font-bold text-[#111827] sm:text-2xl">💬 고객 후기</h2>
      </div>
      <a
        href="/reviews"
        class="shrink-0 text-sm font-medium text-[#E11D48] transition-colors hover:text-[#be123c]"
      >
        더보기 →
      </a>
    </div>

    <div id="reviews-marquee-loading" class="px-4 sm:px-6">
      <div class="mx-auto flex max-w-6xl gap-4 overflow-hidden">
        <div class="h-28 w-72 shrink-0 animate-pulse rounded-xl bg-slate-200"></div>
        <div class="h-28 w-72 shrink-0 animate-pulse rounded-xl bg-slate-200"></div>
        <div class="h-28 w-72 shrink-0 animate-pulse rounded-xl bg-slate-200"></div>
      </div>
    </div>

    <div id="reviews-marquee-empty" class="mx-auto hidden max-w-6xl px-4 text-center sm:px-6">
      <p class="text-sm text-[#6B7280]">아직 등록된 고객 후기가 없습니다.</p>
      <a href="/reviews" class="mt-2 inline-block text-sm font-medium text-[#E11D48] hover:text-[#be123c]">
        첫 후기 남기기 →
      </a>
    </div>

    <div id="reviews-marquee-viewport" class="reviews-marquee-viewport hidden">
      <div id="reviews-marquee-track" class="reviews-marquee-track"></div>
    </div>
  </section>

  <!-- 3. 실전 영상 리뷰 섹션 -->
  <section
    id="youtube-long"
    class="section-spacing border-t border-slate-200/60 bg-white py-14 sm:py-16"
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="section-title mb-3">
        <span class="block text-sm font-medium text-[#6B7280] sm:text-base"
          >GR COLLECTIVE 멘토 올라포토</span
        >
        <span class="mt-1 block text-2xl font-bold text-[#111827] sm:text-3xl"
          >📺 리코 시리즈 매뉴얼 클래스</span
        >
      </h2>
      <div class="scroll-section-wrapper relative">
        <button type="button" id="youtube-long-prev" class="scroll-section-prev" aria-label="이전"> <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg> </button>
        <button type="button" id="youtube-long-next" class="scroll-section-next" aria-label="다음"> <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg> </button>
        <div
          id="youtube-long-grid"
          class="scroll-row flex w-full min-w-0 gap-8 pb-2 pl-4 sm:pl-6 pr-4 sm:pr-6"
        >
        <div
          class="animate-pulse shrink-0 w-[280px] sm:w-[340px] rounded-lg overflow-hidden bg-gray-200 aspect-video"
        >
        </div>
        <div
          class="animate-pulse shrink-0 w-[280px] sm:w-[340px] rounded-lg overflow-hidden bg-gray-200 aspect-video"
        >
        </div>
        <div
          class="animate-pulse shrink-0 w-[280px] sm:w-[340px] rounded-lg overflow-hidden bg-gray-200 aspect-video"
        >
        </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. 고품격! 올라포토 카메라/렌즈 리뷰 (블로그) -->
  <section
    id="blog"
    class="section-spacing border-t border-slate-200/60 bg-white py-14 sm:py-16"
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="section-title mb-3">
        <span class="block text-sm font-medium text-[#6B7280] sm:text-base"
          >실전 촬영 기반 전문가 리뷰</span
        >
        <span class="mt-1 block text-2xl font-bold text-[#111827] sm:text-3xl"
          >✍ 고품격! 올라포토 카메라/렌즈 리뷰</span
        >
      </h2>
      <div class="scroll-section-wrapper relative">
        <button type="button" id="blog-grid-prev" class="scroll-section-prev" aria-label="이전"> <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg> </button>
        <button type="button" id="blog-grid-next" class="scroll-section-next" aria-label="다음"> <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg> </button>
        <div
          id="blog-grid"
          class="scroll-row flex w-full min-w-0 gap-8 pb-2 pl-4 sm:pl-6 pr-4 sm:pr-6"
        >
        <div
          class="animate-pulse shrink-0 w-[209px] rounded-lg overflow-hidden bg-gray-200 aspect-[209/314]"
        >
        </div>
        <div
          class="animate-pulse shrink-0 w-[209px] rounded-lg overflow-hidden bg-gray-200 aspect-[209/314]"
        >
        </div>
        <div
          class="animate-pulse shrink-0 w-[209px] rounded-lg overflow-hidden bg-gray-200 aspect-[209/314]"
        >
        </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. 빠르게 보는 장비 팁 (Shorts) -->
  <section
    id="youtube-shorts"
    class="section-spacing border-t border-slate-200/60 bg-white py-14 sm:py-16"
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="section-title mb-3">
        <span class="block text-sm font-medium text-[#6B7280] sm:text-base"
          >Shorts로 보는 핵심 포인트</span
        >
        <span class="mt-1 block text-2xl font-bold text-[#111827] sm:text-3xl"
          >🎬 빠르게 보는 장비 팁</span
        >
